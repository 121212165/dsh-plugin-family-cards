{
  "name": "dsh-plugin-family-cards",
  "version": "0.1.0",
  "description": "DeepSeek Harness client plugin: rich toolview cards for the 121212165 family plugins (quota/pinboard/cost-ledger/cache-guard/relay-quota/transcript-search/fact-vault/deep-scan/eco-scan/task-forge).",
  "type": "module",
  "private": true,
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
